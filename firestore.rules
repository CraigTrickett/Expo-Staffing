// Expo Staffing — Firestore security rules
//
// Deploy with: firebase deploy --only firestore:rules
// (or paste into Firebase Console → Firestore Database → Rules)
//
// Admin access now requires real Firebase Auth sign-in (see
// FIREBASE_SETUP.md, "Enable admin login") — but that's enforced in the
// app's Cloud Functions (exchangeGoogleAuthCode, disconnectGoogleCalendar,
// deleteEvent, adminUpdateEvent all check request.auth server-side), not
// here. These rules stay wide open on boothEvents because staff must be
// able to claim/release shifts by writing directly to this same document
// without logging in, and Firestore's rules language has no clean way to
// allow "staff can edit bookings" while blocking "someone edits capacity"
// on one shared document. Tightening that further would mean moving
// bookings into their own subcollection — a real option later, not done
// here.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /boothEvents/{eventId} {
      allow read, write: if true;
    }

    // Google Calendar OAuth refresh tokens live here (written only by the
    // exchangeGoogleAuthCode Cloud Function, read only by onEventWrite).
    // No client, admin or otherwise, should ever read or write this
    // collection directly — the default-deny below is intentional and
    // must stay in place even if other rules in this file change.
    match /organizerCalendarTokens/{eventId} {
      allow read, write: if false;
    }
  }
}
